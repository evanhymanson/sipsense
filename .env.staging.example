# .env.staging.example
# Copy to .env.staging and fill in values:
#   cp .env.staging.example .env.staging

# ── Database ──────────────────────────────────────────────────────────
# Docker Compose sets DATABASE_URL via docker-compose.staging.yml.
# Only set this if running outside Docker.
# DATABASE_URL=postgresql://sipsense:sipsense_dev@localhost:5432/sipsense_staging
POSTGRES_PASSWORD=sipsense_dev

# ── Authentication ────────────────────────────────────────────────────
# MUST be different from production to prevent token cross-contamination.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=staging-only-jwt-secret-change-me

# ── AI / Claude ───────────────────────────────────────────────────────
# Leave blank to disable AI chat in staging (saves money).
# Set a key when you specifically need to test chat features.
ANTHROPIC_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080

# ── Analytics ─────────────────────────────────────────────────────────
ANALYTICS_ENABLED=false

# ── Error Tracking ───────────────────────────────────────────────────
# Use a separate Sentry project for staging, or leave blank.
# SENTRY_DSN=

# ── Admin ─────────────────────────────────────────────────────────────
# After running refresh-staging.sh, the first anonymized user is user_0001
ADMIN_USERS=user_0001

# ── External APIs ─────────────────────────────────────────────────────
# Leave blank to avoid costs and rate limits in staging.
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
