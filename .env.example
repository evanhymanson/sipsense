# SipSense Environment Configuration
# Copy this file to .env and fill in real values:
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────
# Docker Compose sets DATABASE_URL automatically. Only set this if running
# outside Docker or connecting to an external database.
# DATABASE_URL=postgresql://sipsense:your_password@localhost:5432/sipsense
POSTGRES_PASSWORD=sipsense_dev

# ── Authentication ────────────────────────────────────────────────────────
# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING

# ── AI / Claude ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── CORS (comma-separated origins) ───────────────────────────────────────
# In Docker, the frontend nginx proxies API calls, so CORS isn't strictly
# needed. Set this if your frontend is on a different domain.
CORS_ORIGINS=http://localhost

# ── Analytics ────────────────────────────────────────────────────────────
# ANALYTICS_ENABLED=true
# ANALYTICS_SAMPLE_RATE=1.0
# ANALYTICS_SALT=change-me-to-a-random-string
# ANALYTICS_RETENTION_DAYS=90
# SLOW_QUERY_THRESHOLD_MS=500

# ── Error Tracking (Sentry) ─────────────────────────────────────────────
# SENTRY_DSN=https://your-key@o123.ingest.sentry.io/456
# VITE_SENTRY_DSN=https://your-key@o123.ingest.sentry.io/789

# ── Admin ────────────────────────────────────────────────────────────────
# ADMIN_USERS=your_username

# ── AI Model Overrides ─────────────────────────────────────────────────
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_MODEL_SMALL=claude-haiku-4-5-20251001

# ── S3 / CDN (leave blank for local file storage) ────────────────────────
# S3_BUCKET=sipsense-media
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# CDN_BASE_URL=https://cdn.sipsense.ai

# ── Optional ──────────────────────────────────────────────────────────────
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
# KAGGLE_API_TOKEN=
