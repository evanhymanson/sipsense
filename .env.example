# SipSense Environment Configuration
# Copy this file to .env and fill in real values:
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────
# Docker Compose sets DATABASE_URL automatically. Only set this if running
# outside Docker or connecting to an external database.
# DATABASE_URL=postgresql://sipsense:your_password@localhost:5432/sipsense
POSTGRES_PASSWORD=sipsense_dev

# ── Authentication ────────────────────────────────────────────────────────
# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING

# ── AI / Claude ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── CORS (comma-separated origins) ───────────────────────────────────────
# In Docker, the frontend nginx proxies API calls, so CORS isn't strictly
# needed. Set this if your frontend is on a different domain.
CORS_ORIGINS=http://localhost

# ── Optional ──────────────────────────────────────────────────────────────
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
