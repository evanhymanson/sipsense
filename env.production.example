# SipSense PRODUCTION Environment
# Copy to .env.production on the production server:
#   cp env.production.example .env.production

# ── Environment ─────────────────────────────────────────────────────────
SIPSENSE_ENV=production

# ── Database ────────────────────────────────────────────────────────────
# Docker Compose sets DATABASE_URL automatically via docker-compose.production.yml.
# Only set manually if running outside Docker.
POSTGRES_PASSWORD=CHANGE_ME_strong_production_password

# ── Authentication ──────────────────────────────────────────────────────
# CRITICAL: Use a strong, unique secret. Never reuse the staging secret.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_production_secret

# ── AI / Claude ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── CORS ────────────────────────────────────────────────────────────────
# Set to your production domain
CORS_ORIGINS=https://yourdomain.com

# ── Rate Limiting ───────────────────────────────────────────────────────
RATE_LIMIT_MAX=300
