# SipSense STAGING Environment
# Copy to .env.staging on the staging server:
#   cp env.staging.example .env.staging

# ── Environment ─────────────────────────────────────────────────────────
SIPSENSE_ENV=staging

# ── Database ────────────────────────────────────────────────────────────
# Docker Compose sets DATABASE_URL automatically via docker-compose.staging.yml.
# Only set manually if running outside Docker.
POSTGRES_PASSWORD=CHANGE_ME_staging_password

# ── Authentication ──────────────────────────────────────────────────────
# Use a DIFFERENT secret than production!
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_staging_secret

# ── AI / Claude ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── CORS ────────────────────────────────────────────────────────────────
# Set to your staging domain
CORS_ORIGINS=https://staging.yourdomain.com

# ── Rate Limiting (lower in staging for easier testing) ─────────────────
RATE_LIMIT_MAX=100
